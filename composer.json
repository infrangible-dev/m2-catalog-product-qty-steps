{
    "name": "infrangible/m2-catalog-product-qty-steps",
    "description": "Replaces the free quantity field with a dropdown of fixed quantity steps (for example 1, 5, 10, 25) on product pages, in the cart and in the mini cart.",
    "type": "magento2-module",
    "version": "1.2.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "Cart & checkout",
        "quantity steps drop-down",
        "fixed order quantities",
        "quantity increments selection"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-qty-steps",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductQtySteps\\": "src"
        }
    }
}
